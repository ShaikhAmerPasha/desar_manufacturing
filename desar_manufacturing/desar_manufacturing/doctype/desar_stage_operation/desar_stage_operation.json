    {
      "fieldname": "operation",
      "fieldtype": "Link",
      "label": "Operation",
      "options": "Operation",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 3,
      "description": "ERPNext Operation doctype"
    },
    {
      "fieldname": "workstation",
      "fieldtype": "Link",
      "label": "Workstation",
      "options": "Workstation",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 3,
      "description": "ERPNext Workstation doctype"
    },
    {
      "fieldname": "time_in_mins",
      "fieldtype": "Float",
      "label": "Time (mins)",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 2,
      "default": "60"
    },
    {
      "fieldname": "sequence_id",
      "fieldtype": "Int",
      "label": "Sequence",
      "in_list_view": 1,
      "columns": 1,
      "description": "Order of operations within this stage"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1, "write": 1, "create": 1, "delete": 1
    },
    {
      "role": "Manufacturing Manager",
      "read": 1, "write": 1, "create": 1, "delete": 1
    }
  ]
}

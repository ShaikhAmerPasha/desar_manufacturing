{
  "name": "DESAR Stage Operation",
  "doctype": "DocType",
  "module": "Desar Manufacturing",
  "istable": 1,
  "editable_grid": 1,
  "track_changes": 0,
  "description": "Operations within a production stage. Each stage can have multiple operations (e.g. Weaving stage has Loom Loading + Weaving operations).",
